# SkillHub backend environment.
# For local dev, copy this file to backend/.env (already git-ignored).
# For Vercel/production, set these in the project's Environment Variables.

# --- Database (portable) ---
# Local bundled Postgres cluster (port 5433):
DATABASE_URL=postgresql://skillhub@127.0.0.1:5433/skillhub
# Managed Postgres (Vercel/Neon/Supabase) - include TLS, e.g.:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# Leaving DATABASE_URL unset falls back to a local SQLite file (zero-config dev).

# --- Runtime mode / security ---
# REQUIRED for public use. Any value other than prod/production = development mode.
# Production turns ON: mandatory secret, forced email delivery, dev-OTP suppression, rate limiting.
SKILLHUB_ENV=production
# REQUIRED in production: long random string used to sign JWTs (32+ chars). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SKILLHUB_SECRET=replace-with-a-long-random-secret
# Only for a private demo WITHOUT SMTP. NEVER enable this on a public site:
# SKILLHUB_ALLOW_DEV_OTP=1

# --- CORS ---
# Comma-separated allowed frontend origin(s). Unset = allow all (local dev only).
SKILLHUB_ORIGINS=https://your-app.vercel.app

# --- Uploaded files ---
# Directory for lesson/picture uploads. On serverless this is ephemeral - point it at a
# persistent volume, or front uploads with object storage before going public.
# SKILLHUB_UPLOADS=/data/uploads

# --- Email OTP (SMTP) - required in production ---
# When set, verification codes are emailed and never leaked in API responses.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=SkillHub <noreply@example.com>